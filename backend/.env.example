# Copiez ce fichier en backend/.env puis renseignez les valeurs.
# Le fichier .env ne doit jamais être versionné.

# 3001 : le serveur du front (src/index.js) utilise déjà le port 3000.
PORT=3001

# Base MongoDB lancée avec le docker-compose à la racine du dépôt :
MONGO_URI=mongodb://admin:secret123@localhost:27017/taskflow?authSource=admin

# Secret de signature des JWT : une longue chaîne aléatoire, propre à chaque environnement.
# Pour en générer un : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Origines autorisées à appeler l'API, séparées par des virgules
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Coût du hash bcrypt (10 à 12 en production)
BCRYPT_ROUNDS=10
