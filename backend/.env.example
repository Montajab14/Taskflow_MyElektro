# Copiez ce fichier en backend/.env puis renseignez les valeurs.
# Le fichier .env ne doit jamais être versionné.

# 3001 : le serveur du front (frontend/src/index.js) utilise déjà le port 3000.
PORT=3001

# Base MongoDB lancée avec le docker-compose à la racine du dépôt :
# remplacez <mot-de-passe> par le MONGO_ROOT_PASSWORD du fichier .env de la racine.
MONGO_URI=mongodb://admin:<mot-de-passe>@localhost:27017/taskflow?authSource=admin

# Secret de signature des JWT : une longue chaîne aléatoire, propre à chaque environnement.
# Pour en générer un : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Origines autorisées à appeler l'API, séparées par des virgules
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Coût du hash bcrypt (10 à 12 en production)
BCRYPT_ROUNDS=10

# Échecs d'inscription ou de connexion tolérés par adresse IP, et durée de la
# fenêtre en minutes. Au-delà, l'API répond 429. Les connexions réussies ne comptent pas.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15
