# Variables lues par docker-compose.yml.
# Copiez ce fichier en .env (à la racine du dépôt) puis renseignez les valeurs.
# Le fichier .env ne doit jamais être versionné.

# Compte administrateur MongoDB créé au premier lancement.
# Mot de passe en lettres et chiffres uniquement : il est repris tel quel dans les URI de connexion.
# Pour en générer un : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=

# Secret de signature des JWT de l'API.
# Pour en générer un : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port de MongoDB exposé sur la machine, à changer si 27017 est déjà pris.
# MONGO_PORT=27019
