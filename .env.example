# Port d'écoute du serveur
PORT=3000

# Chaîne de connexion MongoDB :
# 1. Si Node.js tourne SUR VOTRE PC (hors Docker) et Mongo dans Docker :
MONGO_URI=mongodb://admin:secret123@localhost:27017/taskflow?authSource=admin

# 2. Si Node.js tourne DANS DOCKER (via docker-compose) :
# MONGO_URI=mongodb://admin:secret123@mongodb:27017/taskflow?authSource=admin

