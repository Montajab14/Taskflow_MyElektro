# Port d'écoute du serveur
PORT=3000

# Identifiants du compte administrateur MongoDB créé par le docker-compose.
# Choisissez votre propre mot de passe (lettres et chiffres uniquement, il est repris
# tel quel dans les URI de connexion). Pour en générer un :
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=

# Chaîne de connexion MongoDB (remplacez <mot-de-passe> par MONGO_ROOT_PASSWORD) :
# 1. Si Node.js tourne SUR VOTRE PC (hors Docker) et Mongo dans Docker :
MONGO_URI=mongodb://admin:<mot-de-passe>@localhost:27017/taskflow?authSource=admin

# 2. Si Node.js tourne DANS DOCKER (via docker-compose) :
# MONGO_URI=mongodb://admin:<mot-de-passe>@mongodb:27017/taskflow?authSource=admin

# Secret de signature des JWT, utilisé par le service "api" du docker-compose.
# Générez-en un avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
