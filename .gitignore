# Dépendances Node.js
node_modules/
package-lock.json.bak

# Variables d'environnement et secrets (.env à la racine, backend/.env…)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Journaux
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Docker et données locales
mongo_data/
docker-compose.override.yml

# Builds, couverture de tests et caches
dist/
build/
coverage/
.nyc_output/
.cache/
tmp/
temp/

# Fichiers système (Windows, macOS, Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Éditeurs et IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
