# ==============================================================================
# TaskFlow — Fichier .gitignore
# ==============================================================================

# Dépendances Node.js
node_modules/
package-lock.json.bak

# Variables d'environnement & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Fichiers de logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Docker & Données locales (MongoDB, volumes temporaires)
mongo_data/
docker-compose.override.yml

# Builds, Couverture de tests & Caches
dist/
build/
coverage/
.nyc_output/
.cache/
tmp/
temp/

# Fichiers système (Windows / macOS / Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Configurations d'éditeurs & IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

